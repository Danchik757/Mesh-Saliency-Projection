#!/usr/bin/env bash
# new_machine.env.sh.template — environment variables for a fresh machine
#
# After running scripts/download_datasets.sh --data-root /path/to/data:
#   1. Copy this file to test/env/local_paths.sh  (gitignored)
#   2. Set DATA_ROOT below to your chosen data directory
#   3. source test/env/local_paths.sh
#
# All dataset/CSV variables are derived automatically from DATA_ROOT.
# Camera JSONs are versioned in this repository under jsons/.

# ── Set this to where you extracted the datasets ──────────────────────────────
export DATA_ROOT="/path/to/data"   # ← CHANGE THIS

# ── Derived paths (do not edit unless your layout differs) ────────────────────

export REPROJECT_DATASET_3DVA_ROOT="$DATA_ROOT/3DVA"
export REPROJECT_DATASET_MESHMAMBA_ROOT="$DATA_ROOT/MeshMamba"
export REPROJECT_DATASET_SAL3D_ROOT="$DATA_ROOT/SAL3D"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export REPROJECT_CANONICAL_JSON_ROOT="$REPO_ROOT/jsons/object_placement"

export REPROJECT_GAZE_CSV_3DVA_ROOT="$DATA_ROOT/gaze_csv/3DVA"
export THREE_DVA_CSV_ROOT="$REPROJECT_GAZE_CSV_3DVA_ROOT"
export REPROJECT_GAZE_JSON_3DVA_ROOT="$REPROJECT_CANONICAL_JSON_ROOT/3dva_jsons"
export THREE_DVA_JSON_ROOT="$REPROJECT_GAZE_JSON_3DVA_ROOT"
export THREE_DVA_COMBINED_GT_DIR="$DATA_ROOT/3DVA/CombinedGT"

export REPROJECT_GAZE_CSV_MESHMAMBA_NON_TEXTURE_ROOT="$DATA_ROOT/gaze_csv/MeshMamba_non_texture"
export MESHMAMBA_CSV_ROOT="$REPROJECT_GAZE_CSV_MESHMAMBA_NON_TEXTURE_ROOT"
export REPROJECT_GAZE_JSON_MESHMAMBA_NON_TEXTURE_ROOT="$REPROJECT_CANONICAL_JSON_ROOT/mamba_non_jsons"
export MESHMAMBA_JSON_ROOT="$REPROJECT_GAZE_JSON_MESHMAMBA_NON_TEXTURE_ROOT"

export REPROJECT_GAZE_CSV_MESHMAMBA_RGB_TEXTURE_ROOT="$DATA_ROOT/gaze_csv/MeshMamba_rgb_texture"
export MESHMAMBA_RGB_TEXTURE_CSV_ROOT="$REPROJECT_GAZE_CSV_MESHMAMBA_RGB_TEXTURE_ROOT"
export REPROJECT_GAZE_JSON_MESHMAMBA_RGB_TEXTURE_ROOT="$REPROJECT_CANONICAL_JSON_ROOT/mamba_rgb_jsons"
export MESHMAMBA_RGB_TEXTURE_JSON_ROOT="$REPROJECT_GAZE_JSON_MESHMAMBA_RGB_TEXTURE_ROOT"

export REPROJECT_GAZE_CSV_SAL3D_ROOT="$DATA_ROOT/gaze_csv/SAL3D"
export SAL3D_CSV_ROOT="$REPROJECT_GAZE_CSV_SAL3D_ROOT"
export REPROJECT_GAZE_JSON_SAL3D_ROOT="$REPROJECT_CANONICAL_JSON_ROOT/sal3d_jsons"
export SAL3D_JSON_ROOT="$REPROJECT_GAZE_JSON_SAL3D_ROOT"
export REPROJECT_SAL3D_SMOOTH_GAZE_ROOT="$DATA_ROOT/SAL3D/Smooth_Gaze"

export REPROJECT_VIDEO_3DVA_ROOT="$DATA_ROOT/videos/3DVA"
export REPROJECT_VIDEO_MESHMAMBA_NON_TEXTURE_ROOT="$DATA_ROOT/videos/MeshMamba_non_texture"
export REPROJECT_VIDEO_MESHMAMBA_RGB_TEXTURE_ROOT="$DATA_ROOT/videos/MeshMamba_rgb_texture"
export REPROJECT_VIDEO_SAL3D_ROOT="$DATA_ROOT/videos/SAL3D"

# Repo output (local results, not in release)
export REPROJECT_OUTPUT_ROOT="$REPO_ROOT/test/output_local"
