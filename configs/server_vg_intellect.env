#!/usr/bin/env bash
# Coordinator/server template for the v2 release-only benchmark.
#
# All paths stay below /mnt/ssd1/29d_kon/acm_2026. Override
# REPROJECT_WORKSPACE_NAME when using an agent-specific clone.

export REPROJECT_SERVER_ROOT="${REPROJECT_SERVER_ROOT:-/mnt/ssd1/29d_kon/acm_2026}"
export REPROJECT_WORKSPACE_NAME="${REPROJECT_WORKSPACE_NAME:-coordinator}"
export REPROJECT_RELEASE_TAG="${REPROJECT_RELEASE_TAG:-v2.0-data-rc1}"

export REPO_ROOT="${REPROJECT_SERVER_ROOT}/agents/${REPROJECT_WORKSPACE_NAME}/Mesh-Saliency-Projection"
export REPROJECT_REPO_ROOT="${REPO_ROOT}"
export OUTPUT_ROOT="${REPROJECT_SERVER_ROOT}/outputs/${REPROJECT_WORKSPACE_NAME}"
export REPROJECT_OUTPUT_ROOT="${OUTPUT_ROOT}"
export RELEASE_DOWNLOAD_ROOT="${REPROJECT_SERVER_ROOT}/shared_release_data/${REPROJECT_RELEASE_TAG}"
export RELEASE_DATA_ROOT="${RELEASE_DOWNLOAD_ROOT}/extracted"
export REPROJECT_CANONICAL_JSON_ROOT="${REPO_ROOT}/jsons/object_placement"

export CONDA_ENVS_ROOT="${REPROJECT_SERVER_ROOT}/environments"
export CONDA_ENV_NAME="${CONDA_ENV_NAME:-reproject-benchmark}"
export REPROJECT_PYTHON="${CONDA_ENVS_ROOT}/${CONDA_ENV_NAME}/bin/python"

# Dataset OBJ/GT roots extracted from the validated release candidate.
export VISUAL_ATTENTION_3D_SHAPES_ROOT="${RELEASE_DATA_ROOT}/datasets/3DVA"
export REPROJECT_DATASET_3DVA_ROOT="${VISUAL_ATTENTION_3D_SHAPES_ROOT}"
export THREE_DVA_COMBINED_GT_DIR="${VISUAL_ATTENTION_3D_SHAPES_ROOT}/CombinedGT"

export MESHMAMBA_NON_TEXTURE_ROOT="${RELEASE_DATA_ROOT}/datasets/MeshMamba"
export MESHMAMBA_RGB_TEXTURE_ROOT="${RELEASE_DATA_ROOT}/datasets/MeshMamba"
export REPROJECT_DATASET_MESHMAMBA_ROOT="${MESHMAMBA_NON_TEXTURE_ROOT}"
export REPROJECT_DATASET_MESHMAMBA_RGB_TEXTURE_ROOT="${MESHMAMBA_RGB_TEXTURE_ROOT}"

export SAL3D_DATASET_ROOT="${RELEASE_DATA_ROOT}/datasets/SAL3D"
export REPROJECT_DATASET_SAL3D_ROOT="${SAL3D_DATASET_ROOT}"
export SAL3D_SMOOTH_GAZE_DIR="${SAL3D_DATASET_ROOT}/Smooth_Gaze"
export REPROJECT_SAL3D_SMOOTH_GAZE_ROOT="${SAL3D_SMOOTH_GAZE_DIR}"

# Participant inputs are intentionally separate. New benchmark evaluators must
# use the processed root. The CSV roots are compatibility-only until migration
# is complete; there is no automatic fallback between the two formats.
export REPROJECT_PROCESSED_FIXATIONS_ROOT="${RELEASE_DATA_ROOT}/participant_fixations_processed_offset_2000"
export REPROJECT_ORIGINAL_GAZE_CSV_ROOT="${RELEASE_DATA_ROOT}/participant_gaze_csv_original"

export THREE_DVA_PROCESSED_FIXATIONS_ROOT="${REPROJECT_PROCESSED_FIXATIONS_ROOT}"
export MESHMAMBA_PROCESSED_FIXATIONS_ROOT="${REPROJECT_PROCESSED_FIXATIONS_ROOT}"
export SAL3D_PROCESSED_FIXATIONS_ROOT="${REPROJECT_PROCESSED_FIXATIONS_ROOT}"

export THREE_DVA_CSV_ROOT="${REPROJECT_ORIGINAL_GAZE_CSV_ROOT}/3DVA"
export MESHMAMBA_CSV_ROOT="${REPROJECT_ORIGINAL_GAZE_CSV_ROOT}/MeshMamba_non_texture"
export MESHMAMBA_RGB_TEXTURE_CSV_ROOT="${REPROJECT_ORIGINAL_GAZE_CSV_ROOT}/MeshMamba_rgb_texture"
export SAL3D_CSV_ROOT="${REPROJECT_ORIGINAL_GAZE_CSV_ROOT}/SAL3D"

export THREE_DVA_JSON_ROOT="${REPROJECT_CANONICAL_JSON_ROOT}/3dva_jsons"
export MESHMAMBA_JSON_ROOT="${REPROJECT_CANONICAL_JSON_ROOT}/mamba_non_jsons"
export MESHMAMBA_RGB_TEXTURE_JSON_ROOT="${REPROJECT_CANONICAL_JSON_ROOT}/mamba_rgb_jsons"
export SAL3D_JSON_ROOT="${REPROJECT_CANONICAL_JSON_ROOT}/sal3d_jsons"

export THREE_DVA_OUTPUT_DIR="${OUTPUT_ROOT}/3DVA"
export MESHMAMBA_OUTPUT_DIR="${OUTPUT_ROOT}/MeshMamba"
export SAL3D_OUTPUT_DIR="${OUTPUT_ROOT}/SAL3D"

# Legacy scripts may still mention SIDE_INPUTS_ROOT. Do not use that fallback in
# new runs; use the explicit roots above.
export SIDE_INPUTS_ROOT="${RELEASE_DATA_ROOT}"
export MAMBA_GAZE_ROOT="${REPO_ROOT}/MAMBA_GAZE"

export WORKERS="${WORKERS:-12}"
export NICE_LEVEL="${NICE_LEVEL:-10}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
